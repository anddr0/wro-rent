# --- Supabase (server only; the browser never talks to Supabase directly) ---
# Local:  npx supabase status -o env → API_URL, SECRET_KEY
# Cloud:  Dashboard → Project Settings → API Keys
SUPABASE_URL=
# sb_secret_…: full access, keep it on the server
SUPABASE_SECRET_KEY=

# --- Telegram ---
# Bot token from @BotFather (dev bot locally, prod bot in production)
BOT_TOKEN=
# Public HTTPS URL of this app: ngrok domain in dev, production domain in prod
APP_URL=
# Random string, Telegram sends it back in a header on every webhook call
# Generate: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

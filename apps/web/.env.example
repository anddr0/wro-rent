# --- Supabase ---
# Local:  npx supabase status -o env → API_URL, PUBLISHABLE_KEY, SECRET_KEY
# Cloud:  Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
# sb_publishable_…: safe for the browser, access limited by RLS
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# sb_secret_…: full access, server only
SUPABASE_SECRET_KEY=

# --- Telegram ---
# Bot token from @BotFather (dev bot locally, prod bot in production)
BOT_TOKEN=
# Public HTTPS URL of this app: ngrok domain in dev, production domain in prod
APP_URL=
# Random string, Telegram sends it back in a header on every webhook call
# Generate: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

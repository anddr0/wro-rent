# Supabase: Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram bot token from @BotFather (use a separate dev bot locally)
BOT_TOKEN=
# Public HTTPS URL of this app: ngrok domain in dev, production domain in prod
APP_URL=
# Random string, Telegram sends it back in a header on every webhook call
# Generate: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

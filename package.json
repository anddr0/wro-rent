{
  "name": "vityas-bike-rent",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @vityas/web",
    "build": "npm run build -w @vityas/web",
    "lint": "npm run lint -w @vityas/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "webhook:set": "npm run webhook:set -w @vityas/web",
    "webhook:info": "npm run webhook:info -w @vityas/web",
    "webhook:delete": "npm run webhook:delete -w @vityas/web",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/db/src/database.types.ts"
  },
  "devDependencies": {
    "supabase": "^2.122.0"
  },
  "engines": {
    "node": ">=22"
  }
}
